#!/usr/bin/env bash
#
# Update a Photog install. Run it from your Photog directory:
#
#   ./scripts/update-photog                 # update to the newest release
#   ./scripts/update-photog 0.1.6           # update to a specific version
#   ./scripts/update-photog --check         # say what would change, do nothing
#   ./scripts/update-photog --no-backup     # skip the database dump
#
# You do not need to know anything about Docker Compose to use this. It does, in
# order:
#
#   1. back up the database
#   2. refresh the compose files, nginx.conf and the scripts from GitHub
#   3. warn about settings this release has made wrong
#   4. pull the new image and restart
#   5. check it came back, and report what is and is not switched on
#
# WHY THIS EXISTS
#
# `docker compose pull && docker compose up -d` is the whole upgrade, and it is
# also not enough, for reasons nobody should have to keep in their head:
#
#   * A release can change docker-compose.yml. Compose passes through only the
#     environment variables the file names, so a new setting is inert until the
#     file that forwards it is taken as well — documented, shipped, and silently
#     doing nothing. That has happened at least once (PHOTOG_LOAD_GAZETTEER).
#   * A release can stop publishing a tag. An install whose COMPOSE_FILE still
#     names a retired overlay gets `manifest unknown`, which reads as a broken
#     registry rather than a stale setting.
#   * A raw Postgres directory is not a backup, and a schema migration is not
#     reversible by pinning the old tag again.
#
# Each of those is one step below, in the order that makes the next one safe.

set -euo pipefail

REPO="${PHOTOG_REPO:-unsilo/photog-docker}"
RAW="https://raw.githubusercontent.com/${REPO}/main"

CHECK=0
BACKUP=1
TARGET=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --check|--dry-run) CHECK=1 ;;
    --no-backup)       BACKUP=0 ;;
    -h|--help)         sed -n '3,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)                echo "unknown option: $1" >&2; exit 2 ;;
    *)                 TARGET="$1" ;;
  esac
  shift
done

ok()   { printf '\033[1;32m  ok\033[0m  %s\n' "$*"; }
bad()  { printf '\033[1;31mfail\033[0m  %s\n' "$*"; }
warn() { printf '\033[1;33mwarn\033[0m  %s\n' "$*"; }
info() { printf '      %s\n' "$*"; }
step() { printf '\n\033[1m==> %s\033[0m\n' "$*"; }
die()  { bad "$*"; exit 1; }

# --- where are we ----------------------------------------------------------
#
# Everything below is relative to the directory holding .env, and Compose reads
# COMPOSE_FILE from that .env — so being in the wrong directory would not fail,
# it would quietly operate on a different (or default) stack. Refuse instead.

[[ -f .env ]] || die "no .env here. cd to your Photog directory (usually ~/photog) and run this again."
[[ -f docker-compose.yml ]] || die "no docker-compose.yml here. Is this a Photog directory?"

command -v docker >/dev/null 2>&1 || die "docker is not installed"
docker compose version >/dev/null 2>&1 || die "the Docker Compose plugin is missing (need Compose v2)"

# The service is `photog`. It was `web` in early versions, and `docker compose
# exec web` on a current install says `service "web" is not running`, which reads
# as a container that is down rather than a name that has changed.
SERVICE=photog

current_tag="$(grep -E '^PHOTOG_TAG=' .env | head -1 | cut -d= -f2- || true)"
info "directory      $(pwd)"
info "current tag    ${current_tag:-unset (tracking latest)}"
[[ -n "$TARGET" ]] && info "target tag     ${TARGET}"
[[ $CHECK -eq 1 ]] && warn "--check: nothing will be written, pulled or restarted"

# --- 1. back up ------------------------------------------------------------
#
# Before anything else, because a migration is the one part of an upgrade that a
# tag pin cannot undo. `-Fc` is the custom format: compressed, and restorable
# selectively.

step "1/5  database backup"

if [[ $BACKUP -eq 0 ]]; then
  warn "skipped (--no-backup). A schema change cannot be undone by re-pinning the old tag."
elif [[ $CHECK -eq 1 ]]; then
  info "would write photog-db-$(date +%F).dump"
else
  db_user="$(grep -E '^POSTGRES_USER=' .env | head -1 | cut -d= -f2- || true)"
  db_name="$(grep -E '^POSTGRES_DB=' .env | head -1 | cut -d= -f2- || true)"
  dump="photog-db-$(date +%F-%H%M).dump"

  if docker compose ps --status running --services 2>/dev/null | grep -qx db; then
    # Redirect to a temp name and rename on success: a failed pg_dump still
    # creates the file, and a zero-byte dump that looks like a backup is worse
    # than no backup at all.
    if docker compose exec -T db pg_dump -U "${db_user:-photog}" -Fc "${db_name:-pho_tog_prod}" > "${dump}.part" 2>/dev/null; then
      mv "${dump}.part" "$dump"
      ok "wrote ${dump} ($(du -h "$dump" | cut -f1))"
    else
      rm -f "${dump}.part"
      warn "pg_dump failed. Continuing, but you have no backup of this state."
      info "To stop here instead, ^C now."
      sleep 5
    fi
  else
    warn "the database container is not running, so there is nothing to dump"
    info "That is normal if the stack is stopped. Nothing is at risk yet either."
  fi
fi

# --- 2. refresh the files --------------------------------------------------
#
# .env is NEVER touched here. It holds generated secrets and the operator's
# choices; a release has no business rewriting it. Everything else in this list
# is ours and is replaced wholesale.

step "2/5  refresh compose files and scripts"

FILES=(docker-compose.yml docker-compose.hailo.yml docker-compose.python.yml nginx.conf .env.example)
SCRIPTS=(env-detect.sh download-models.sh upgrade-hailort.sh rollback-hailort.sh update-photog)

fetch() {
  local url="$1" dest="$2"
  # Fetch to .tmp and move: an interrupted curl must not leave a truncated
  # docker-compose.yml behind, because the next `up -d` would read it.
  if curl -fsSL "$url" -o "${dest}.tmp" 2>/dev/null; then
    if [[ -f "$dest" ]] && cmp -s "${dest}.tmp" "$dest"; then
      rm -f "${dest}.tmp"
      return 2   # unchanged
    fi
    if [[ $CHECK -eq 1 ]]; then
      rm -f "${dest}.tmp"
      return 0   # would change
    fi
    mv "${dest}.tmp" "$dest"
    return 0
  fi
  rm -f "${dest}.tmp"
  return 1
}

changed=0
for f in "${FILES[@]}"; do
  set +e; fetch "${RAW}/${f}" "$f"; rc=$?; set -e
  case $rc in
    0) changed=$((changed + 1)); [[ $CHECK -eq 1 ]] && info "would update ${f}" || ok "updated ${f}" ;;
    2) : ;;
    1) warn "could not fetch ${f} — keeping the copy you have" ;;
  esac
done

mkdir -p scripts
for s in "${SCRIPTS[@]}"; do
  set +e; fetch "${RAW}/scripts/${s}" "scripts/${s}"; rc=$?; set -e
  case $rc in
    0) changed=$((changed + 1))
       [[ $CHECK -eq 1 ]] && info "would update scripts/${s}" || { chmod +x "scripts/${s}"; ok "updated scripts/${s}"; } ;;
    2) [[ $CHECK -eq 0 ]] && chmod +x "scripts/${s}" ;;
    1) warn "could not fetch scripts/${s} — keeping the copy you have" ;;
  esac
done

[[ $changed -eq 0 ]] && info "everything already current"

# hailo-detect.sh became env-detect.sh. Left in place it keeps working for a
# while and then silently stops matching the docs, which is the worst of both.
if [[ -f scripts/hailo-detect.sh ]]; then
  if [[ $CHECK -eq 1 ]]; then
    info "would remove scripts/hailo-detect.sh (now scripts/env-detect.sh)"
  else
    rm -f scripts/hailo-detect.sh
    ok "removed scripts/hailo-detect.sh — it is scripts/env-detect.sh now"
  fi
fi

# --- 3. settings this release has made wrong -------------------------------
#
# Checked AFTER the refresh, so the advice matches the files now on disk, and
# BEFORE the pull, so a setting that would make the pull fail is reported as a
# setting rather than as a registry error.

step "3/5  check your settings against this release"

problems=0

compose_file="$(grep -E '^COMPOSE_FILE=' .env | head -1 | cut -d= -f2- || true)"

if [[ "$compose_file" == *docker-compose.python.yml* || "$compose_file" == *docker-compose.moondream.yml* ]]; then
  problems=$((problems + 1))
  bad "COMPOSE_FILE names a captioning overlay: ${compose_file}"
  info "That overlay selects an image tag that is no longer published, so the"
  info "pull below will fail with 'manifest unknown'."
  info ""
  info "Descriptions do not need it any more — every image can caption, and the"
  info "environment is built the first time you enable moondream. Fix it with:"
  info ""
  if [[ "$compose_file" == *hailo* ]]; then
    info "  COMPOSE_FILE=docker-compose.yml:docker-compose.hailo.yml"
  else
    info "  COMPOSE_FILE=docker-compose.yml"
  fi
  info ""
  info "or let env-detect.sh work it out:  ./scripts/env-detect.sh --append"
fi

if [[ "$compose_file" == *hailo* ]] && ! grep -qE '^HAILO_GID=' .env; then
  problems=$((problems + 1))
  bad "the Hailo overlay is in COMPOSE_FILE but .env has no HAILO_ values"
  info "Compose will refuse to start. Run: ./scripts/env-detect.sh --append"
fi

if ! grep -qE '^PHOTOG_TAG=' .env; then
  warn "PHOTOG_TAG is unset, so this tracks 'latest'"
  info "Pin it. It makes upgrading a decision rather than a side effect."
fi

[[ $problems -eq 0 ]] && ok "nothing to fix"
[[ $problems -gt 0 && $CHECK -eq 0 ]] && die "fix the above and run this again"

# --- 4. pull and restart ---------------------------------------------------

step "4/5  pull and restart"

if [[ -n "$TARGET" ]]; then
  if [[ $CHECK -eq 1 ]]; then
    info "would set PHOTOG_TAG=${TARGET} in .env"
  else
    # Truncate-and-write rather than mv, so .env keeps its mode 600 and owner.
    tmp="$(mktemp)"
    if grep -qE '^PHOTOG_TAG=' .env; then
      TAG="$TARGET" awk '$0 ~ /^PHOTOG_TAG=/ { if (!s) { print "PHOTOG_TAG=" ENVIRON["TAG"]; s=1 } next } { print }' .env > "$tmp"
    else
      { cat .env; printf 'PHOTOG_TAG=%s\n' "$TARGET"; } > "$tmp"
    fi
    cat "$tmp" > .env && rm -f "$tmp"
    ok "PHOTOG_TAG=${TARGET}"
  fi
fi

if [[ $CHECK -eq 1 ]]; then
  info "would run: docker compose pull && docker compose up -d"
  info ""
  info "Nothing was changed. Re-run without --check to do it."
  exit 0
fi

# No -f flags anywhere in this script: COMPOSE_FILE in .env is the single source
# of truth for which stack this is, and passing -f here would override it and
# quietly run a different one.
docker compose pull
docker compose up -d

# --- 5. did it come back ---------------------------------------------------
#
# `up -d` returning 0 means Compose started the containers, not that the
# application is serving. Migrations run on boot and the first boot after an
# upgrade can take minutes on a Pi, so wait on the healthcheck rather than
# declaring success and leaving the operator to discover otherwise.

step "5/5  waiting for it to come back"

deadline=$((SECONDS + 420))
state=""
while [[ $SECONDS -lt $deadline ]]; do
  state="$(docker compose ps --format '{{.Service}} {{.Health}}' 2>/dev/null | awk -v s="$SERVICE" '$1 == s {print $2; exit}')"
  [[ "$state" == "healthy" ]] && break
  if ! docker compose ps --status running --services 2>/dev/null | grep -qx "$SERVICE"; then
    bad "the ${SERVICE} container is not running"
    info "docker compose logs --tail 50 ${SERVICE}"
    exit 1
  fi
  sleep 5
done

if [[ "$state" == "healthy" ]]; then
  ok "${SERVICE} is healthy"
else
  warn "${SERVICE} has not reported healthy after 7 minutes"
  info "It may still be migrating — that is legitimate on a Pi, especially the"
  info "first boot with PHOTOG_LOAD_GAZETTEER=true. Watch it:"
  info "  docker compose logs -f ${SERVICE}"
fi

# What is actually switched on. Worth printing unprompted after an upgrade: the
# most common post-upgrade surprise is a feature that silently stopped, and the
# geo diagnostic is the one that can say so.
echo
if docker compose exec -T "$SERVICE" /app/bin/pho_tog eval 'PhoTog.Geo.Diagnostics.print()' 2>/dev/null; then
  :
else
  info "(could not run the geocoding diagnostic — the app may still be starting)"
fi

echo
ok "done"
info "If something is wrong, your backup is the newest photog-db-*.dump here,"
info "and pinning the previous PHOTOG_TAG will roll the image back — though not"
info "a migration. See docs/upgrading.md."
