# PhoTog — copy to `.env` next to docker-compose.yml.
#
#   cp .env.example .env && chmod 600 .env
#
# Compose reads `.env` from the directory it runs in. Four values are required;
# everything else has a working default.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# The hostname you type in the browser. Used for the endpoint URL, the websocket
# origin check, and (unless PHOTOG_IMAGE_URL_BASE overrides it) every image URL
# the UI emits. The app refuses to boot without it.
#
# On a Raspberry Pi whose hostname is `photog`, mDNS gives you photog.local.
# On a laptop, `localhost` is fine.
PHX_HOST=photog.local

# Signs and encrypts session cookies.
#
#   openssl rand -base64 48
SECRET_KEY_BASE=

# Postgres password. The db service publishes no ports, so it is only ever
# reachable on the compose network — pick something random anyway.
#
#   openssl rand -hex 24
#
# Hex, NOT base64. This gets interpolated into DATABASE_URL, and base64 contains
# `/` and `+`, which change how a URL parses: Ecto either raises
# Ecto.InvalidURLError or connects with a silently truncated password. Same
# reason to avoid `@`, `:` and `#` if you pick one by hand.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# First-run admin — you will not be able to log in without this
# ---------------------------------------------------------------------------
# Creates one confirmed admin account, and only while the users table is empty.
# Both must be set. /users/register finishes over a magic-link email and this
# container has no working mailer, so there is no other way in.
#
# Minimum 12 characters. Leaving the password blank logs a warning and creates
# nothing — it does not crash the container, which means a silent lockout.
# Change the password in the UI after first login; these values go inert as soon
# as any account exists.
PHOTOG_ADMIN_EMAIL=you@example.com
PHOTOG_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Where originals and thumbnails live. Unset means the named volume
# `photog-warehouse`, which is under /var/lib/docker — the SD card on a Pi, and
# not where you want a photo library. Give it a path to use a real disk:
#
#   sudo mkdir -p /mnt/photos && sudo chown 1000:1000 /mnt/photos
#
# The 1000:1000 matters. The container runs as uid 1000 and cannot write a
# root-owned directory; the failure surfaces as thumbnails that never appear
# rather than as anything at startup.
#PHOTOG_WAREHOUSE_PATH=/mnt/photos

# The folder the import screen starts in — drop photos here to bring them in.
# Defaults to ./import next to this file.
#PHOTOG_IMPORT_PATH=/mnt/incoming

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Image tag to run. Pinning a version makes upgrading a decision rather than a
# side effect of `docker compose pull`.
PHOTOG_TAG=0.1.0

# Port the nginx proxy publishes. 80 is the whole point of having the proxy: it
# makes `http://photog.local` — no port — a valid address, which is what the
# app's default image URLs and the iOS/tvOS Release builds assume.
#
# Change it only if something else already owns 80, and if you do, set
# PHOTOG_IMAGE_URL_BASE below to include the port. Otherwise thumbnails 404 with
# correct-looking URLs.
#PHOTOG_HTTP_PORT=80

# Base URL for every <img> the UI emits. Leave unset and the compose file uses
# http://${PHX_HOST}, correct as long as the proxy is on port 80. Set it if
# PHOTOG_HTTP_PORT is not 80, or if something in front terminates TLS.
#PHOTOG_IMAGE_URL_BASE=https://photos.example.com

# Websocket origins, comma-separated. Left blank, the app derives a list from
# PHX_HOST that covers the normal case. Set it when you also reach the server by
# IP address — an Origin the derived list does not contain gets the socket
# rejected, and the symptom is a page that renders and then never becomes
# interactive.
#PHOTOG_CHECK_ORIGIN=http://photog.local,http://192.168.1.50

# Where the app container itself is published, bypassing the proxy. Loopback
# only by default: two reachable origins for the same app is how you end up with
# broken images for whoever used the "wrong" one.
#PHOTOG_DIRECT_BIND=0.0.0.0:4000

# Self-service signup at /users/register. Off by default, and note that PhoTog
# has no per-user ownership of photos, albums or tags — a second account is a
# second key to the same library, not a second library. Registration also needs
# a mailer this container does not have, so `true` on its own is not enough.
#PHOTOG_ALLOW_REGISTRATION=false

# Ecto pool size. 6 is a reasonable ceiling for 4 cores shared with Postgres.
#POOL_SIZE=6

# Postgres role and database names. Changing these after first boot renames
# nothing — the volume still holds the old database.
#POSTGRES_USER=photog
#POSTGRES_DB=pho_tog_prod

# Start without running migrations, to get a shell after a bad upgrade.
#PHOTOG_SKIP_MIGRATIONS=true

# ---------------------------------------------------------------------------
# Hailo accelerator — only with docker-compose.hailo.yml. See docs/hailo.md.
# ---------------------------------------------------------------------------
# Run scripts/hailo-detect.sh on the host; it prints these four lines filled in.
#
# The char device is NOT always /dev/hailo0 — HailoRT 5.3.0's own driver names
# it /dev/h1x-0. Wrong name and Docker refuses to start the container with
# "error gathering device information ... no such file or directory".
#HAILO_DEVICE=/dev/h1x-0
#HAILO_GID=993
#HAILO_PYTHON_PACKAGE=/usr/lib/python3/dist-packages/hailo_platform
#HAILORT_LIB=/usr/lib/aarch64-linux-gnu/libhailort.so.5.3.0
#HAILORT_SONAME=libhailort.so.5.3.0

# Host directory holding your .hef model files. Required by the overlay.
#PHOTOG_MODELS_PATH=/mnt/photos/hailo-models

# Force an inference API instead of letting the worker choose by HailoRT major
# version. Leave unset unless detection goes wrong.
#PHOTOG_HAILO_API=infer_model

# Captioning (qwen2) only. A VLM instance degrades as it runs — generations get
# slower, and past a few hundred it can fail outright. The worker reloads the
# model by itself after a failed generation; these two address the underlying
# accumulation. Turn them on one at a time so you can tell which one helped.
#
# Ask HailoRT to economise on-die memory. The model is most of the card.
#PHOTOG_VLM_OPTIMIZE_MEMORY=1
#
# Reload the model every N generations. Removes the slowdown and the cliff, at
# the cost of a reload every N photos.
#PHOTOG_VLM_RECYCLE_EVERY=50
